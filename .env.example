# Copy to .env — docker compose reads it automatically.

# Your home directory on the host. ~/.claude is mounted from here, and the
# backend container uses the same path as HOME so the CLI feels at home.
HOST_HOME=/Users/you

# This repository's absolute path. Must sit inside PROJECTS_DIR.
REPO_DIR=/Users/you/Documents/PythonProjects/agents-orchestrator

# One folder containing every project you list in config.yaml. Mounted into the
# backend at the same path, which is what lets agents open those folders.
PROJECTS_DIR=/Users/you/Documents

# How the containerised CLI authenticates. On macOS the desktop login lives in
# the Keychain and cannot be shared with a container, so set one of these:
#   claude setup-token   -> paste the result as CLAUDE_CODE_OAUTH_TOKEN
#   an API key           -> ANTHROPIC_API_KEY
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
